.claude/settings.local.json

# 一時ファイルの置き場
.tmp/

# git worktree（.worktrees/next は次の機能の実装、.worktrees/polish はソフトウェア面の改善）
.worktrees/

# 走行の記録（機械が出す JSONL）
traces/

# 人が実験で使うファイル（指示のファイルなど）。手元だけ
experiments/

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/

# macOS
.DS_Store
